--- /dev/null
+++ b/drivers/spi/spi-sh-hspi.c
@@ -0,0 +1,415 @@
+/*
+ * SuperH HSPI driver
+ *
+ * Copyright (C) 2012 Kuninori Morimoto <kuninori.morimoto.gx-zM6kxYcvzFBBDgjK7y7TUQ@public.gmane.org>
+ *
+ * Based on spi-sh.c:
+ * Based on pxa2xx_spi.c:
+ * Copyright (C) 2011 Renesas Solutions Corp.
+ * Copyright (C) 2005 Stephen Street / StreetFire Sound Labs
+ *
